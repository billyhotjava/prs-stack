{
  "$schema": "https://dts.yuzhi.com/schemas/pack-manifest-v1.json",
  "id": "prs-pack",
  "name": "Plants Rental Platform",
  "version": "0.1.0",
  "minPlatformVersion": "2.5.0",
  "vendor": "Yuzhi Tech",
  "description": "Independent plant-rental operations pack for DTS hosting.",
  "rpcBaseUrl": "http://prs-backend:8080",
  "frontend": {
    "remoteEntryUrl": "http://prs-frontend/assets/remoteEntry.js",
    "exposedModules": [
      {
        "name": "./Workbench",
        "routePath": "/prs/workbench",
        "menuLabel": "Field Workbench"
      },
      {
        "name": "./CustomerPortalHome",
        "routePath": "/prs/customer",
        "menuLabel": "Customer Portal"
      },
      {
        "name": "./ExecutiveCockpit",
        "routePath": "/prs/executive",
        "menuLabel": "Executive Cockpit"
      }
    ],
    "sharedDeps": ["react", "react-dom"]
  },
  "skills": [
    {
      "id": "prs-operations-routing",
      "toolType": "rpc",
      "endpoint": "http://prs-backend:8080/api/skill/execute",
      "timeoutSeconds": 30,
      "description": "Routes PRS skill requests to backend handlers."
    },
    {
      "id": "prs-plant-issue-draft",
      "toolType": "rpc",
      "endpoint": "http://prs-backend:8080/api/skill/execute",
      "timeoutSeconds": 30,
      "description": "Drafts plant issue summaries from field intake before supervisor approval."
    },
    {
      "id": "prs-feedback-routing",
      "toolType": "rpc",
      "endpoint": "http://prs-backend:8080/api/skill/execute",
      "timeoutSeconds": 30,
      "description": "Explains how customer feedback will be routed through operations review."
    },
    {
      "id": "prs-reconciliation-explain",
      "toolType": "rpc",
      "endpoint": "http://prs-backend:8080/api/skill/execute",
      "timeoutSeconds": 30,
      "description": "Explains reconciliation differences for finance review."
    }
  ],
  "ontology": {
    "objectTypes": "ontology/apppack.json"
  },
  "menus": "config/menus.json",
  "permissions": "config/permissions.json"
}
