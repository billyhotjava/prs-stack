#!/usr/bin/env bash
set -euo pipefail
prs_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -ne 1 ]]; then echo 'Usage: DTS_PACK_CLI=/path/to/pack-cli build-studio-pack /new/output.dtspack' >&2; exit 2; fi
pack_cli="${DTS_PACK_CLI:-${STUDIO_PACK_CLI:-dts-pack-cli}}"
if ! command -v "$pack_cli" >/dev/null 2>&1; then echo 'Set DTS_PACK_CLI to the installed dts-common Pack CLI.' >&2; exit 1; fi
"$pack_cli" validate "$prs_dir/pack/studio" --strict
exec "$pack_cli" build "$prs_dir/pack/studio" -o "$1" --strict
